# Copy to .env and fill in. Never commit the real .env file.

# Must match Program 1's RELAY_SHARED_SECRET exactly.
RELAY_SHARED_SECRET=change-me-to-a-long-random-string

# How far a request's timestamp may drift from "now" before it's rejected
# as a possible replay.
SIGNATURE_TOLERANCE_SECONDS=300

# --- Where finished, signed contracts are actually saved ---
# Filename is built from FILENAME_TEMPLATE, e.g. ACC-00123_20260806-163624.pdf
OUTPUT_DIR=/var/contract-pipeline/signed
FILENAME_TEMPLATE={account_number}_{saved_at}.pdf
FILENAME_DATETIME_FORMAT=%Y%m%d-%H%M%S

# --- DEBUG-ONLY: raw inputs dumped here alongside the real save, for
# troubleshooting a bad merge without re-triggering a real signature. ---
RECEIVED_DUMP_DIR=/tmp/program2_received

# --- Signature placement (PDF points, origin bottom-left, page 1-indexed,
# -1 = last page) - tune these against your actual contract template. ---
SIGNATURE_PAGE_NUMBER=-1
SIGNATURE_X=72
SIGNATURE_Y=110
SIGNATURE_MAX_WIDTH=220
SIGNATURE_MAX_HEIGHT=70

# --- Account number / saved-at stamp printed on the contract itself ---
STAMP_PAGE_NUMBER=-1
STAMP_X=72
STAMP_Y=70
STAMP_FONT_NAME=Helvetica
STAMP_FONT_SIZE=9
STAMP_TEXT_TEMPLATE=Account: {account_number}    Signed: {saved_at}
STAMP_DATETIME_FORMAT=%Y-%m-%d %H:%M:%S UTC

# --- PostgreSQL: where the contract hash record is stored ---
# Either set DATABASE_URL (wins if set)...
# DATABASE_URL=postgresql://contract_pipeline:password@db-host:5432/contract_pipeline?sslmode=require
# ...or the individual POSTGRES_* values:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contract_pipeline
POSTGRES_USER=contract_pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_APPLICATION_NAME=contract-signing-pipeline
POSTGRES_SCHEMA=public
POSTGRES_TABLE=signed_contracts

PORT=8443
