# Copy to .env and fill in. Never commit the real .env file.

# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret API key - needed to call the Files API and download the signature
# SVG (the webhook itself only gives us a file ID).
STRIPE_API_KEY=sk_live_...

# Only set this when running scripts/fake_stripe_files_server.py for local
# testing. Leave commented out / unset in production.
# STRIPE_API_BASE=http://localhost:9999

# Dot-path into the Stripe event's data.object for the account number -
# confirm this after inspecting a real event (see README "Verifying the
# Stripe event shape"). The signature file ID's location is fixed by
# Stripe's collect_inputs schema and isn't configurable.
ACCOUNT_NUMBER_PATH=metadata.account_number

# Blank contract template, known fixed name/location on this machine.
CONTRACT_TEMPLATE_PATH=/etc/contract-pipeline/blank_contract.pdf

# Program 2, running on the other machine.
PROGRAM2_URL=https://program2.internal:8443/webhook/contract

# Shared secret used to HMAC-sign the Program1 -> Program2 request.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be identical on both machines. Keep it out of source control.
RELAY_SHARED_SECRET=change-me-to-a-long-random-string

PORT=5000
